# For running the backend directly (cd server; node index.js). Copy to server/.env. Never commit .env.
# Docker Compose does not use this file; it uses the root .env.example.
PORT=3100
NODE_ENV=development

# Local MySQL container mysql-tp. If mysql2 times out on 127.0.0.1:3307, use the container IP and port 3306.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=root
DB_NAME=theme_park

# Generate one with: openssl rand -hex 32
SESSION_SECRET=change-me

SEED_ADMIN_PASSWORD=
SEED_MANAGER_PASSWORD=
SEED_CASHIER_PASSWORD=

# Optional: where the built frontend lives (default: ../client/dist)
# CLIENT_DIST=
