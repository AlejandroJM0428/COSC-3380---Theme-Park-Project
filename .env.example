# Docker Compose settings. Copy to .env in the repo root and fill in. Never commit .env.
# (For running the backend without Docker, use server/.env.example instead.)

# MySQL root password. The app connects to MySQL as root over the private compose network.
DB_PASSWORD=change-me

# Signs the session cookie. Generate one with: openssl rand -hex 32
SESSION_SECRET=change-me

# development = works over plain http (LAN test at http://<geto-ip>:3100).
# production  = adds the Secure cookie flag. Use it only when people reach the app through https (the Cloudflare tunnel).
NODE_ENV=development

# Host port the app is published on (3001 belongs to betonme-server)
APP_PORT=3100

# Optional: choose the seed passwords. If empty, the seed script generates and prints them once.
SEED_ADMIN_PASSWORD=
SEED_MANAGER_PASSWORD=
SEED_CASHIER_PASSWORD=
SEED_RETAIL_PASSWORD=
SEED_HR_PASSWORD=
SEED_MAINTMGR_PASSWORD=
SEED_TECH_PASSWORD=
SEED_COOK_PASSWORD=
